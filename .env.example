# Copy to .env.local and fill in. Never commit a filled-in copy.
#
# Both values below are safe to ship to the browser: the publishable key is
# public by design, and every permission is enforced by row level security in
# Postgres. That is why it is the only key the application ever sees.
#
# Find them in the Supabase dashboard under Project Settings -> API.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# The service role key bypasses row level security completely. It must never
# appear in this file, in any VITE_ variable, or anywhere in src/. It belongs
# only in server-side Edge Function secrets.
